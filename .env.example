# SPECTRAMARK Environment Configuration
APP_NAME=SPECTRAMARK
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=spectramark-super-secret-salt-key-change-in-production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Database (SQLite by default, PostgreSQL in production)
DATABASE_URL=sqlite:///./spectramark.db

# File Storage
UPLOAD_DIR=./data/uploads
PROCESSED_DIR=./data/processed
REPORTS_DIR=./data/reports
MAX_UPLOAD_SIZE_MB=25
MAX_IMAGE_PIXELS=67108864

# Worker Pool
MAX_WORKER_THREADS=8

